<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="utf-8">
  <style>
    :root{--green:#087b3d;--deep:#075b30;--yellow:#f4dc19;--pale:#f2faef}
    *{box-sizing:border-box}body{margin:0;background:#f3f6f2;color:#183326;font-family:Arial,sans-serif}
    .hero{background:linear-gradient(135deg,var(--deep),var(--green));color:white;padding:18px 16px 22px;text-align:center;border-bottom:6px solid var(--yellow)}
    .logo{width:94px;height:94px;object-fit:contain;background:white;border-radius:50%;padding:4px;border:3px solid var(--yellow)}
    .building{width:100%;max-height:190px;object-fit:cover;border-radius:12px;margin-top:12px}
    h1{font-size:22px;margin:10px 0 4px}.sub{font-size:13px;line-height:1.5}
    main{max-width:850px;margin:18px auto;padding:0 12px 40px}
    .card{background:white;border-radius:14px;padding:16px;margin:12px 0;box-shadow:0 2px 12px #153d2010}
    h2{font-size:18px;color:var(--deep);margin:0 0 12px}
    label{display:block;font-weight:600;font-size:14px;margin:10px 0 6px}
    input[type=text],textarea{width:100%;padding:12px;border:1px solid #cbd8cc;border-radius:9px;font-size:15px}
    .q{padding:14px 0;border-bottom:1px solid #e6eee7}.q:last-child{border:0}
    .qtitle{font-weight:600;line-height:1.5;margin-bottom:10px}
    .opt{display:block;background:#f7faf7;padding:10px;border-radius:9px;margin:7px 0;font-weight:400;line-height:1.4}
    .opt input{margin-right:8px;accent-color:var(--green)}
    textarea{min-height:95px;resize:vertical}
    button{width:100%;background:var(--green);color:white;border:0;border-radius:11px;padding:15px;font-size:16px;font-weight:bold;cursor:pointer}
    button:disabled{opacity:.6}.note{font-size:12px;color:#637268;line-height:1.5}
    .pill{display:inline-block;background:#e9f5e9;color:var(--deep);padding:5px 10px;border-radius:20px;font-size:12px;font-weight:bold}
    #status{padding:12px;border-radius:10px;margin-top:12px;display:none;line-height:1.5}
    .success{display:block!important;background:#e5f6e8;color:#075b30}.error{display:block!important;background:#ffeded;color:#9b1c1c}
    @media(min-width:650px){.identity{display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px}.hero{padding:22px}}
  </style>
</head>
<body>
<header class="hero">
  <img class="logo" src="data:image/jpeg;base64," alt="Logo MTs Al Hidayah">
  <h1>LATIHAN ASAS FIKIH KELAS 7</h1>
  <div class="sub">MTs AL HIDAYAH SUKATANI<br>Semester Ganjil • Tahun Pelajaran 2026/2027<br><b>Kurikulum Berbasis Cinta (KBC)</b></div>
  <img class="building" src="data:image/jpeg;base64," alt="Gedung MTs Al Hidayah Sukatani">
</header>
<main>
  <section class="card">
    <h2>Identitas Peserta Didik</h2>
    <div class="identity">
      <div><label>Nama lengkap</label><input id="name" type="text" placeholder="Nama lengkap siswa" required></div>
      <div><label>Kelas</label><input id="className" type="text" placeholder="Contoh: VII-A" required></div>
      <div><label>Nomor absen</label><input id="absen" type="text" inputmode="numeric" placeholder="Nomor absen" required></div>
    </div>
    <p class="note">Periksa kembali identitas sebelum mengirim jawaban. Rekap akan disiapkan untuk dikirim ke guru Fikih melalui aplikasi email.</p>
  </section>
  <div id="quiz"></div>
  <section class="card">
    <h2>Periksa dan Kirim Jawaban</h2>
    <p class="note">Tombol kirim akan membuka aplikasi email dengan rekap nama, nilai, dan jawaban yang sudah disiapkan. Tekan Kirim pada aplikasi email untuk mengirim. Lima soal uraian menunggu penilaian guru.</p>
    <button id="send" onclick="sendExam()">KIRIM JAWABAN</button>
    <div id="status"></div>
  </section>
</main>
<script>
let bank;
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function render(){
  const root=document.getElementById('quiz'); let out='';
  out += section('A. Pilihan Ganda (20 Soal)','pg',bank.pg,(q,i)=>`<div class="q"><div class="qtitle">${i+1}. ${esc(q[0])}</div>${q[1].map((o,j)=>`<label class="opt"><input type="radio" name="pg${i}" value="${'ABCD'[j]}"> ${'ABCD'[j]}. ${esc(o)}</label>`).join('')}</div>`);
  out += section('B. Benar atau Salah (10 Soal)','tf',bank.tf,(q,i)=>`<div class="q"><div class="qtitle">${i+1}. ${esc(q[0])}</div><label class="opt"><input type="radio" name="tf${i}" value="Benar"> Benar</label><label class="opt"><input type="radio" name="tf${i}" value="Salah"> Salah</label></div>`);
  out += section('C. Isian Singkat (10 Soal)','short',bank.short,(q,i)=>`<div class="q"><div class="qtitle">${i+1}. ${esc(q[0])}</div><input type="text" id="short${i}" placeholder="Tuliskan jawaban singkat"></div>`);
  out += section('D. Uraian (5 Soal)','essay',bank.essay,(q,i)=>`<div class="q"><div class="qtitle">${i+1}. ${esc(q[0])}</div><textarea id="essay${i}" placeholder="Tuliskan jawaban dengan jelas..."></textarea></div>`);
  root.innerHTML=out;
}
function section(title,kind,items,fn){return `<section class="card"><h2>${title}</h2><span class="pill">${items.length} soal</span>${items.map(fn).join('')}</section>`;}
function collect(){
  const a={};
  bank.pg.forEach((q,i)=>{const x=document.querySelector(`input[name="pg${i}"]:checked`);a['pg'+i]=x?x.value:'';});
  bank.tf.forEach((q,i)=>{const x=document.querySelector(`input[name="tf${i}"]:checked`);a['tf'+i]=x?x.value:'';});
  bank.short.forEach((q,i)=>a['short'+i]=document.getElementById('short'+i).value);
  bank.essay.forEach((q,i)=>a['essay'+i]=document.getElementById('essay'+i).value);
  return a;
}
function sendExam(){
  const name=document.getElementById('name').value.trim(),className=document.getElementById('className').value.trim(),absen=document.getElementById('absen').value.trim();
  const status=document.getElementById('status'),btn=document.getElementById('send');
  if(!name||!className||!absen){status.className='error';status.textContent='Lengkapi nama, kelas, dan nomor absen terlebih dahulu.';return;}
  if(!confirm('Kirim jawaban sekarang? Pastikan semua jawaban sudah diperiksa.'))return;
  const answers=collect();
  let pgScore=0,tfScore=0,shortScore=0;
  bank.pg.forEach((q,i)=>{if(answers['pg'+i]===q[2])pgScore++;});
  bank.tf.forEach((q,i)=>{if(answers['tf'+i]===(q[1]?'Benar':'Salah'))tfScore++;});
  bank.short.forEach((q,i)=>{const v=(answers['short'+i]||'').trim().toLowerCase();if(q[1].some(x=>x.toLowerCase()===v))shortScore++;});
  const total=pgScore+tfScore+shortScore;
  const lines=[
    'HASIL LATIHAN ASAS FIKIH - MTs AL HIDAYAH SUKATANI',
    'Nama: '+name,'Kelas: '+className,'Nomor absen: '+absen,
    'Nilai objektif: '+total+'/40',
    'PG: '+pgScore+'/20','Benar/Salah: '+tfScore+'/10','Isian: '+shortScore+'/10',
    'Nilai akhir menunggu pemeriksaan 5 soal uraian.',
    '',
    'JAWABAN SISWA:',
    ...Object.entries(answers).map(([k,v])=>k+': '+(v||'(kosong)'))
  ];
  const subject=encodeURIComponent('Hasil ASAS Fikih - '+name+' ('+className+')');
  const body=encodeURIComponent(lines.join('\n'));
  status.className='success';
  status.innerHTML='Rekap sudah disiapkan. Aplikasi akan membuka aplikasi email dengan alamat guru dan hasil jawaban. Tekan <b>Kirim</b> pada aplikasi email untuk mengirim.';
  btn.textContent='BUKA EMAIL UNTUK KIRIM';
  window.location.href='mailto:rian@al-hidayah.sch.id?subject='+subject+'&body='+body;
}
bank = {"pg": [["Saat akan salat Zuhur, Farhan menyadari tangannya terkena najis. Tindakan yang tepat sebelum berwudu adalah …", ["Langsung salat karena sudah berwudu", "Membersihkan najis terlebih dahulu, lalu berwudu jika diperlukan", "Mengusap tangan dengan parfum", "Mengganti pakaian tanpa membersihkan tangan"], "B", "Bersuci dari najis berbeda dengan berwudu. Najis harus dibersihkan terlebih dahulu."], ["Nadia hendak berwudu, tetapi air di keran sangat sedikit. Ia menggunakan air secukupnya dan tidak membiarkan keran mengalir terus. Sikap Nadia mencerminkan …", ["Israf dalam menggunakan air", "Menunda kewajiban", "Menjaga kebersihan sekaligus mencintai lingkungan", "Mengganti wudu dengan tayamum tanpa alasan"], "C", "Menghemat air saat bersuci merupakan bentuk tanggung jawab menjaga lingkungan."], ["Dalam perjalanan, Raka menemukan air yang berubah warna dan berbau karena tercampur kotoran. Air tersebut sebaiknya …", ["Digunakan untuk berwudu karena semua air suci", "Tidak digunakan untuk bersuci karena terkena najis", "Dicampur sabun lalu diminum", "Digunakan hanya untuk membasuh wajah"], "B", "Air yang berubah sifat karena najis tidak digunakan untuk bersuci."], ["Urutan anggota wudu yang benar setelah membasuh wajah adalah …", ["Membasuh kedua tangan sampai siku", "Mengusap kedua kaki", "Membasuh telinga saja", "Membasuh kepala lalu wajah"], "A", "Setelah wajah, kedua tangan dibasuh sampai siku."], ["Ketika berwudu, Siti lupa membasuh kedua tangan sampai siku dan langsung mengusap kepala. Ia menyadari kesalahannya sebelum selesai. Sikap yang tepat adalah …", ["Meneruskan wudu karena tidak masalah", "Mengulang dari awal tanpa memperbaiki bagian yang tertinggal", "Membasuh bagian yang tertinggal dan melanjutkan sesuai ketentuan", "Mengganti wudu dengan mandi wajib"], "C", "Bagian wudu yang tertinggal harus dipenuhi dengan memperhatikan urutan."], ["Sebelum salat, seorang siswa memastikan badan, pakaian, dan tempat salat bersih dari najis. Hal ini menunjukkan perhatian pada …", ["Syarat sah salat", "Hal yang membatalkan puasa", "Rukun zakat", "Syarat wajib haji"], "A", "Suci badan, pakaian, dan tempat dari najis termasuk syarat sah salat."], ["Azan Zuhur telah berkumandang. Dimas masih asyik bermain dan sengaja menunda salat hingga hampir habis waktunya. Nasihat paling tepat adalah …", ["Salat boleh ditinggalkan jika sedang bermain", "Segera menghentikan permainan dan menunaikan salat pada waktunya", "Mengganti salat Zuhur dengan sedekah", "Menunggu teman mengingatkan"], "B", "Salat lima waktu wajib ditunaikan pada waktunya."], ["Salat Subuh dilaksanakan sebanyak …", ["Dua rakaat", "Tiga rakaat", "Empat rakaat", "Lima rakaat"], "A", "Salat Subuh terdiri atas dua rakaat."], ["Salat Magrib memiliki jumlah rakaat …", ["Dua", "Tiga", "Empat", "Lima"], "B", "Salat Magrib terdiri atas tiga rakaat."], ["Waktu pelaksanaan salat Isya dimulai setelah …", ["Matahari terbit", "Matahari tepat di atas kepala", "Hilangnya cahaya merah di ufuk barat", "Sebelum matahari terbenam"], "C", "Waktu Isya dimulai setelah hilangnya mega merah."], ["Ketika mendengar azan, sikap yang mencerminkan cinta Allah dan Rasul-Nya adalah …", ["Mengejek suara azan", "Menghormati azan dan bersiap menunaikan salat", "Memutar musik lebih keras", "Mengajak teman terus bermain"], "B", "Menghormati panggilan salat merupakan wujud ketaatan."], ["Sebelum salat berjamaah dimulai, imam mengingatkan makmum untuk merapatkan dan meluruskan saf. Tujuannya adalah …", ["Agar jamaah terlihat lebih banyak", "Menjaga kerapian dan kesatuan dalam salat", "Agar makmum bebas berpindah tempat", "Supaya imam dapat salat lebih cepat"], "B", "Saf yang rapi menunjukkan keteraturan dan kebersamaan jamaah."], ["Dalam salat berjamaah, posisi makmum laki-laki jika hanya seorang diri adalah …", ["Di depan imam", "Di sebelah kanan imam", "Jauh di belakang imam", "Di sebelah kiri imam"], "B", "Makmum laki-laki tunggal berdiri di sebelah kanan imam."], ["Jika imam melakukan kesalahan gerakan, makmum laki-laki mengingatkan dengan …", ["Bertepuk tangan", "Mengucapkan tasbih", "Berteriak memanggil nama imam", "Meninggalkan saf"], "B", "Makmum laki-laki mengingatkan imam dengan bacaan tasbih."], ["Keutamaan salat berjamaah mengajarkan peserta didik untuk …", ["Merasa lebih hebat dari orang lain", "Membangun kebersamaan dan disiplin", "Membeda-bedakan teman", "Mengabaikan orang yang terlambat"], "B", "Salat berjamaah menumbuhkan persaudaraan, disiplin, dan kebersamaan."], ["Aisyah melihat temannya belum memahami tata cara wudu. Ia kemudian mengajarinya dengan sabar. Perilaku ini mencerminkan …", ["Cinta ilmu dan sesama", "Kesombongan", "Pemborosan", "Permusuhan"], "A", "Berbagi ilmu dengan sabar mencerminkan cinta ilmu dan sesama."], ["Seseorang tidak menemukan air setelah berusaha mencarinya dan waktu salat hampir habis. Keringanan bersuci yang dapat dilakukan sesuai ketentuan adalah …", ["Tayamum", "Mengabaikan salat", "Membasuh dengan minuman", "Menunggu sampai esok hari"], "A", "Tayamum merupakan pengganti wudu atau mandi wajib dalam kondisi yang dibenarkan."], ["Benda yang dapat digunakan untuk tayamum adalah …", ["Debu atau permukaan bumi yang suci", "Air teh", "Minyak goreng", "Kain basah"], "A", "Tayamum dilakukan menggunakan debu atau permukaan bumi yang suci sesuai ketentuan."], ["Ketika salat berjamaah, makmum masbuk datang saat imam sedang rukuk. Ia harus …", ["Langsung mengikuti gerakan imam dengan tertib", "Menunggu imam salam", "Membuat jamaah sendiri di belakang", "Menyuruh imam mengulang salat"], "A", "Makmum masbuk mengikuti imam dalam keadaan apa pun saat ia mendapatinya, dengan memperhatikan ketentuan rakaat."], ["Setelah salat berjamaah, para siswa membersihkan kembali ruang musala. Kegiatan ini menunjukkan …", ["Cinta lingkungan dan tanggung jawab", "Keinginan dipuji", "Menghindari belajar", "Persaingan antarkelas"], "A", "Menjaga kebersihan musala adalah tanggung jawab bersama."]], "tf": [["Bersuci dalam Islam mencakup membersihkan diri dari hadas dan najis.", true, "Bersuci meliputi menghilangkan hadas dan membersihkan najis."], ["Air yang terkena najis hingga berubah warna, bau, atau rasa tetap dapat digunakan untuk wudu.", false, "Air yang berubah karena najis tidak digunakan untuk bersuci."], ["Membasuh wajah termasuk rukun wudu.", true, "Membasuh wajah merupakan salah satu rukun wudu."], ["Menghemat air ketika berwudu bertentangan dengan ajaran menjaga lingkungan.", false, "Menghemat air justru mencerminkan tanggung jawab menjaga lingkungan."], ["Salat lima waktu wajib dilaksanakan oleh setiap muslim yang memenuhi syarat.", true, "Salat lima waktu merupakan kewajiban bagi muslim yang memenuhi syarat."], ["Salat Subuh berjumlah empat rakaat.", false, "Salat Subuh berjumlah dua rakaat."], ["Salat Magrib terdiri atas tiga rakaat.", true, "Jumlah rakaat salat Magrib adalah tiga."], ["Makmum boleh mendahului gerakan imam dengan sengaja dalam salat berjamaah.", false, "Makmum wajib mengikuti imam dan tidak mendahuluinya."], ["Salat berjamaah dapat melatih kedisiplinan dan persaudaraan.", true, "Keteraturan saf dan kebersamaan jamaah melatih disiplin serta ukhuwah."], ["Makmum laki-laki tunggal berdiri di sebelah kanan imam.", true, "Posisi makmum laki-laki tunggal adalah di sebelah kanan imam."]], "short": [["Apa istilah bersuci dari hadas dan najis dalam fikih?", ["thaharah", "taharah"]], ["Sebutkan salah satu contoh najis yang harus dibersihkan sebelum salat.", ["air kencing", "kencing", "darah", "kotoran"]], ["Apa pengganti wudu ketika tidak ada air dan terdapat alasan yang dibenarkan?", ["tayamum"]], ["Anggota tubuh yang dibasuh pertama kali dalam rukun wudu setelah niat adalah …", ["wajah", "muka"]], ["Berapa rakaat salat Subuh?", ["2", "dua"]], ["Berapa rakaat salat Isya?", ["4", "empat"]], ["Apa nama panggilan untuk memberitahukan masuknya waktu salat?", ["azan", "adzan"]], ["Apa istilah orang yang memimpin salat berjamaah?", ["imam"]], ["Apa istilah barisan makmum dalam salat berjamaah?", ["saf", "shaf"]], ["Sebutkan satu nilai Panca Cinta yang tampak ketika siswa menjaga kebersihan musala.", ["cinta lingkungan", "cinta ilmu", "cinta diri sendiri dan sesama", "cinta allah dan rasulnya", "cinta tanah air"]]], "essay": [["Bacalah kasus berikut: Air di sekolah terbatas, sedangkan beberapa siswa akan berwudu. Jelaskan tiga tindakan bijak agar ibadah tetap terlaksana dan air tidak terbuang sia-sia.", "Menilai ketepatan solusi, penghematan air, dan kaitan dengan cinta lingkungan."], ["Rani melihat temannya salat tanpa memastikan pakaian dan tempatnya bersih. Bagaimana cara menasihati teman tersebut dengan santun? Jelaskan alasan pentingnya kebersihan sebelum salat.", "Menilai pemahaman syarat sah salat dan sikap santun/cinta sesama."], ["Jelaskan perbedaan hadas dan najis serta berikan masing-masing satu contoh dan cara menyucikannya.", "Menilai ketepatan konsep, contoh, dan cara bersuci."], ["Di musala sekolah, beberapa siswa datang terlambat sehingga saf menjadi tidak teratur. Apa yang sebaiknya dilakukan imam dan makmum agar salat berjamaah berjalan tertib? Jelaskan manfaatnya.", "Menilai pemahaman adab, posisi saf, mengikuti imam, dan manfaat kebersamaan."], ["Ceritakan satu contoh penerapan Panca Cinta melalui kebiasaan menjaga salat lima waktu dan salat berjamaah di sekolah atau rumah.", "Menilai relevansi contoh, pemahaman nilai Panca Cinta, dan refleksi."]]}; render();
</script>
</body>
</html>
